PORT=5000
DATABASE_URL=mongodb://127.0.0.1:27017/restaurant-voice-agent
PUBLIC_BASE_URL=http://localhost:5000

# Telephony Mode (mock | twilio | vapi)
VOICE_MODE=mock

# Twilio Telephony Credentials (Server-Side Only - Never expose in browser)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+15551234567

# Vapi Telephony Credentials (Optional)
VAPI_API_KEY=your_vapi_api_key_here
VAPI_ASSISTANT_ID=your_vapi_assistant_id_here
VAPI_PHONE_NUMBER_ID=your_vapi_phone_number_id_here

# AI Summarization Provider
GEMINI_API_KEY=your_gemini_api_key_here

# Security
JWT_SECRET=super_secret_jwt_key_2026
